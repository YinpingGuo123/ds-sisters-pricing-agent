# Copy this file to .env and fill in your own values. Never commit .env.
# Each teammate uses their own key and may use a different model.

OPENAI_API_KEY=

# Model selection.
# DEFAULT_MODEL applies to every agent. The per-agent variables below are
# optional: if one is set it wins for that agent, otherwise DEFAULT_MODEL is
# used. No model name is hard-coded anywhere in the code.
DEFAULT_MODEL=
INTAKE_MODEL=
PRICING_MODEL=
QUOTATION_MODEL=

# Reserved for later tracing/evaluation work. The Langfuse SDK is not a
# dependency yet — these are placeholders so the variable names are agreed.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
